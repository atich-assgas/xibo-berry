[Unit]
Description=Berry Xibo Chromium player (community pilot)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/bin/bash %h/xiboplayer-pilot/xiboplayer/launch-kiosk.sh --server-dir=%h/xiboplayer-pilot/xiboplayer/server
ExecStop=/usr/bin/node %h/xiboplayer-pilot/xiboplayer/stop-player.cjs
ExecStopPost=/usr/bin/node %h/xiboplayer-pilot/xiboplayer/stop-player.cjs
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=graphical-session.target
