# Copie este arquivo para .env e preencha os valores privados.
# === DHCP - acesso ao servidor ===
DHCP_USERNAME=
DHCP_PASSWORD=
DHCP_SERVER=

# === BERRIES - rede Wi-Fi ===
BERRY_WIFI_PASSWORD=

# === XIBO CMS - banco e administracao ===
# Manter os valores existentes em instalacoes ja criadas.
XIBO_DB_PASSWORD=
XIBO_ADMIN_USERNAME=
XIBO_ADMIN_PASSWORD=
XIBO_SERVER_NAME=
XIBO_USAGE_REPORT=

# === XIBO PLAYER - conexao e autorizacao opcional ===
# URL acessivel pelos Berries e chave existente do CMS.
XIBO_CMS_URL=
XIBO_CMS_KEY=
XIBO_API_CLIENT_ID=
XIBO_API_CLIENT_SECRET=
